[Unit]
Description=Piper robot daemon (owns CAN, safety layer)
Documentation=file:///opt/piper/refactor/robotd-safety.md
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
# ⚠ **팔에 명령하는 넷(추론·녹화·수동제어·파킹)이 전부 여기를 지난다.**
# 하드리밋·데드맨이 이 프로세스 안에 있으므로, 없는 동안은 안전층도 없다.
# 그래서 되살린다 — 다만 되살아나도 팔은 스스로 움직이지 않는다(명령이 없으면 정지).
Restart=always
RestartSec=2
ExecStart=/usr/bin/python3 /opt/piper/daemons/robotd.py
Environment=PIPER_REDIS_URL=redis://127.0.0.1:6379/0
# 커스텀 파킹 위치를 게이트웨이와 같은 곳에서 읽는다 (정본은 하나다)
Environment=PIPER_CONFIG_DIR=/opt/piper/config
# ⚠ **컨테이너로 못 보낸다.** xHCI 리바인딩이 /sys/bus/pci/drivers/xhci_hcd 에
# 쓰는데, 컨테이너에서 하려면 호스트 권한을 사실상 다 줘야 한다.
# CAN(SocketCAN) + USB 시리얼 접근
SupplementaryGroups=dialout plugdev
# 세그먼트를 소비자(컨테이너 포함)와 공유해야 한다
PrivateTmp=no

[Install]
WantedBy=multi-user.target
