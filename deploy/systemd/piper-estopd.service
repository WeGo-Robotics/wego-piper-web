# E-stop 워치독 — 웹서버와 독립된 프로세스.
#
# 설치:
#   mkdir -p ~/.config/systemd/user
#   sed "s|@REPO@|$PWD|g; s|@PY@|$(which python3)|g" \
#     deploy/systemd/piper-estopd.service > ~/.config/systemd/user/piper-estopd.service
#   systemctl --user daemon-reload && systemctl --user enable --now piper-estopd
#
# ⚠ 로그아웃해도 살아있게 하려면 linger 를 켜야 한다:
#   sudo loginctl enable-linger $USER
# (안 켜면 세션 종료 시 함께 죽는다 — 지금 tmux/학습이 통째로 죽는 것과 같은 원인)

[Unit]
Description=Piper E-stop watchdog
After=redis-server.service
Wants=redis-server.service

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@PY@ @REPO@/daemons/estopd.py
Restart=always
RestartSec=1
# 워치독이 죽어 있으면 안 되므로 재시작 실패로 유닛을 포기하지 않는다
StartLimitIntervalSec=0

[Install]
WantedBy=default.target
