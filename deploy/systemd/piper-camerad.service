# camerad — `/dev/video*` 를 독점하는 데몬 (refactor/daemon-inventory.md #3).
#
# 설치: deploy/install-daemons.sh
#
# ⚠ **rsd 와 합치지 않는다.** D405 의 UVC 질의가 커널 D-state 로 프로세스를 통째로
# 먹통으로 만든 전례가 있어, 합쳐두면 RealSense 가 죽을 때 웹캠까지 죽는다.
# 유닛을 둘로 두는 것이 그 격리를 systemd 수준에서도 유지하는 방법이다.

[Unit]
Description=Piper v4l2 camera daemon (owns /dev/video*)
Documentation=file://@REPO@/refactor/daemon-inventory.md

# ⚠ `StartLimitIntervalSec` 은 **`[Unit]` 에 둔다.** `[Service]` 에 쓰면 이 systemd
# 버전은 "Unknown key name" 으로 **조용히 무시한다** — 기존 estopd 유닛이 그랬고,
# 그래서 재시작 한도가 걸려 있는 줄 알았지만 기본값(10초에 5번)이 그대로였다.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@PY@ @REPO@/daemons/camerad.py
Environment=PIPER_REDIS_URL=redis://127.0.0.1:6379/0

# 장치를 독점하므로 없는 동안 웹캠이 전혀 안 보인다.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
