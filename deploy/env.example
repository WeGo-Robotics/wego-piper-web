# backend/.env 로 복사해 쓴다. `PIPER_` 접두사가 붙은 것만 읽힌다.
#
# ⚠ **여기 없는 값은 코드 기본값을 쓴다.** 그 기본값이 안전한 쪽이 아닌 경우가
#   있으므로(아래 transport 둘) 새 머신에서는 이 파일을 반드시 두고 시작한다.

# ── 전송 방식 ─────────────────────────────────────────────────────────────
# ⚠ **코드 기본값은 둘 다 `direct` 다.** direct 면 LeRobot subprocess 가 CAN 과
#   카메라를 **직접 연다** — robotd 의 안전층(바닥 필터·관절 범위·변화율·데드맨)이
#   통째로 빠지고, 카메라를 여러 소비자가 나눠 볼 수도 없다.
#   실기에서는 shm 이 맞다.
PIPER_ROBOT_TRANSPORT=shm
PIPER_CAMERA_TRANSPORT=shm

# 자식 프로세스를 systemd 유닛으로 띄운다. `local` 이면 게이트웨이가 죽을 때
# 학습·녹화가 화면에서 사라진다(프로세스는 계속 돈다).
PIPER_PROCESS_RUNNER=systemd

# ── 경로 ─────────────────────────────────────────────────────────────────
# PIPER_MODELS_DIR=~/outputs/train
# PIPER_DATASETS_DIR=~/.cache/huggingface/lerobot
PIPER_DEBUG_DIR=./backend/data/debug

# ── 버스 ─────────────────────────────────────────────────────────────────
# 모든 데몬이 이걸로 만난다. 비어 있으면 redis://127.0.0.1:6379/0
# PIPER_REDIS_URL=redis://127.0.0.1:6379/0

# ── 판단 LLM (선택) ───────────────────────────────────────────────────────
# 이 머신 기본은 로컬 Ollama. Anthropic 을 쓰려면 provider 를 바꾸고 키를 넣는다.
PIPER_LLM_PROVIDER=openai_compat
PIPER_LLM_BASE_URL=http://127.0.0.1:11434/v1
PIPER_LLM_MODEL=qwen2.5:7b

# ── 외부 제어 API (선택) ──────────────────────────────────────────────────
# ⚠ **빈 값이면 `/api/ext/v1` 전체가 503 이다** — 그게 기본이고, 그게 맞다.
#   쓰려면 직접 만들어 넣는다:  openssl rand -base64 32
# PIPER_API_TOKEN=
