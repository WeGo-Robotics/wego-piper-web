<mxfile host="app.diagrams.net" agent="claude" version="24.0.0">
  <diagram id="c4-l1" name="L1 — 시스템 컨텍스트">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="&lt;b&gt;C4 · Level 1 — 시스템 컨텍스트&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="900" height="26" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="piper-web 은 로봇이 물리적으로 붙어 있는 한 대의 호스트에서 돈다. 바깥과는 사람·상위 제어·허브·GPU 임대 서버로만 닿는다." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p-op" value="&lt;b&gt;조작자&lt;/b&gt;&lt;br&gt;&lt;i&gt;[사람]&lt;/i&gt;&lt;br&gt;&lt;br&gt;팔을 가르치고(수집) 정책을 학습·평가한다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="96" width="210" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p-ext" value="&lt;b&gt;상위 제어 시스템&lt;/b&gt;&lt;br&gt;&lt;i&gt;[외부]&lt;/i&gt;&lt;br&gt;&lt;br&gt;미션을 투입하고 상태를 폴링한다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="96" width="210" height="92" as="geometry" />
        </mxCell>
        <mxCell id="sys" value="&lt;b&gt;piper-web&lt;/b&gt;&lt;br&gt;&lt;i&gt;[이 저장소]&lt;/i&gt;&lt;br&gt;&lt;br&gt;LeRobot 을 subprocess 로 감싸 웹에서 통제한다 — 수집·학습·추론·평가와 E-stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="300" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e-arm" value="&lt;b&gt;Piper 로봇 팔&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CAN]&lt;/i&gt;&lt;br&gt;&lt;br&gt;관절 지령·상태. robotd 가 독점한다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="168" height="108" as="geometry" />
        </mxCell>
        <mxCell id="e-cam" value="&lt;b&gt;카메라&lt;/b&gt;&lt;br&gt;&lt;i&gt;[USB]&lt;/i&gt;&lt;br&gt;&lt;br&gt;UVC 웹캠 + RealSense D405" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="228" y="590" width="168" height="108" as="geometry" />
        </mxCell>
        <mxCell id="e-hub" value="&lt;b&gt;HuggingFace Hub&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;&lt;br&gt;&lt;br&gt;모델·데이터셋 보관소" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="416" y="590" width="168" height="108" as="geometry" />
        </mxCell>
        <mxCell id="e-ssh" value="&lt;b&gt;원격 학습 서버&lt;/b&gt;&lt;br&gt;&lt;i&gt;[SSH]&lt;/i&gt;&lt;br&gt;&lt;br&gt;GPU 임대. 학습만 내보낸다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="604" y="590" width="168" height="108" as="geometry" />
        </mxCell>
        <mxCell id="e-llm" value="&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;&lt;br&gt;&lt;br&gt;장면 판단 LLM (기본은 로컬 Ollama)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="792" y="590" width="168" height="108" as="geometry" />
        </mxCell>
        <mxCell id="e-reg" value="&lt;b&gt;GHCR&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;&lt;br&gt;&lt;br&gt;설치·업데이트 이미지 배포" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="590" width="168" height="108" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="브라우저에서 조작한다&#10;[HTTP/WS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#8A8A8A;fontColor=#4D4D4D;labelBackgroundColor=#FFFFFF;jettySize=auto;" edge="1" parent="1" source="p-op" target="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="미션·상태·E-stop&#10;[REST /api/ext/v1, Bearer]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#8A8A8A;fontColor=#4D4D4D;labelBackgroundColor=#FFFFFF;jettySize=auto;" edge="1" parent="1" source="p-ext" target="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="관절 지령·상태&#10;[CAN 2.0]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#8A8A8A;fontColor=#4D4D4D;labelBackgroundColor=#FFFFFF;jettySize=auto;" edge="1" parent="1" source="sys" target="e-arm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="프레임 취득&#10;[V4L2 / librealsense]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#8A8A8A;fontColor=#4D4D4D;labelBackgroundColor=#FFFFFF;jettySize=auto;" edge="1" parent="1" source="sys" target="e-cam">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="모델·데이터셋&#10;올리기/내려받기" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#8A8A8A;fontColor=#4D4D4D;labelBackgroundColor=#FFFFFF;jettySize=auto;" edge="1" parent="1" source="sys" target="e-hub">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="학습 잡 실행·로그 회수" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#8A8A8A;fontColor=#4D4D4D;labelBackgroundColor=#FFFFFF;jettySize=auto;" edge="1" parent="1" source="sys" target="e-ssh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="구조화 판단 요청" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#8A8A8A;fontColor=#4D4D4D;labelBackgroundColor=#FFFFFF;jettySize=auto;dashed=1;" edge="1" parent="1" source="sys" target="e-llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="설치 스크립트가 끌어온다" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#8A8A8A;fontColor=#4D4D4D;labelBackgroundColor=#FFFFFF;jettySize=auto;dashed=1;" edge="1" parent="1" source="e-reg" target="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="⚠ 하드웨어는 &lt;b&gt;컨테이너가 직접 열지 않는다&lt;/b&gt;. 카메라·CAN 은 호스트 데몬이 독점하고 컨테이너로는 /dev/shm 세그먼트만 온다. Level 2 에서 그 경계를 본다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="830" y="300" width="300" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="c4-l2" name="L2 — 컨테이너">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="&lt;b&gt;C4 · Level 2 — 컨테이너&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="경계를 긋는 기준은 하나다 — “이것이 죽으면 무엇이 같이 죽어야 하는가?” 장치를 소유하는 넷은 호스트 유닛으로 갈라 두어, rsd 가 물려도 camerad 는 돈다." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p-op" value="&lt;b&gt;조작자&lt;/b&gt;&lt;br&gt;&lt;i&gt;[사람]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="96" width="190" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p-ext" value="&lt;b&gt;상위 제어 시스템&lt;/b&gt;&lt;br&gt;&lt;i&gt;[외부]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="96" width="200" height="76" as="geometry" />
        </mxCell>
        <mxCell id="b-doc" value="컨테이너 — docker compose (bridge net `piper`)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#8A8A8A;fontColor=#6B6B6B;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="196" width="620" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;Web UI&lt;/b&gt;&lt;br&gt;&lt;i&gt;[React + Vite + Tailwind, nginx :80]&lt;/i&gt;&lt;br&gt;&lt;br&gt;수집·학습·추론·저장소·설정 화면. WS 로 로그와 상태를 받는다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="72" y="244" width="270" height="122" as="geometry" />
        </mxCell>
        <mxCell id="gw" value="&lt;b&gt;piper-gateway&lt;/b&gt;&lt;br&gt;&lt;i&gt;[FastAPI + uvicorn :8000]&lt;/i&gt;&lt;br&gt;&lt;br&gt;HTTP/WS 표면, 프로세스 수명, 배타 가드(exclusivity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="362" y="244" width="270" height="122" as="geometry" />
        </mxCell>
        <mxCell id="bus" value="&lt;b&gt;Redis 버스&lt;/b&gt;&lt;br&gt;&lt;i&gt;[piper_bus · unix socket]&lt;/i&gt;&lt;br&gt;&lt;br&gt;E-stop heartbeat·활동 PID·파라미터 큐·녹화 제어·프리뷰/검출 TTL·학습 잡" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="244" width="250" height="122" as="geometry" />
        </mxCell>
        <mxCell id="shm" value="&lt;b&gt;공유 메모리 세그먼트&lt;/b&gt;&lt;br&gt;&lt;i&gt;[piper_shm · ipc: host]&lt;/i&gt;&lt;br&gt;&lt;br&gt;piper.cam.* 프레임 · piper.arm.* 관절 상태" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="244" width="250" height="122" as="geometry" />
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;데이터 루트 /data&lt;/b&gt;&lt;br&gt;&lt;i&gt;[호스트 /srv/piper-data]&lt;/i&gt;&lt;br&gt;&lt;br&gt;데이터셋·모델·체크포인트·로그·HF 캐시" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="244" width="250" height="122" as="geometry" />
        </mxCell>
        <mxCell id="b-run" value="호스트 — 게이트웨이가 띄우는 실행 계층 (GPU 를 쓴다 · 배타)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#8A8A8A;fontColor=#6B6B6B;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="426" width="1000" height="216" as="geometry" />
        </mxCell>
        <mxCell id="run" value="&lt;b&gt;LeRobot 추론·녹화 프로세스&lt;/b&gt;&lt;br&gt;&lt;i&gt;[subprocess · wrapper/]&lt;/i&gt;&lt;br&gt;&lt;br&gt;정책 객체를 런타임에 고쳐야 해서 LeRobot 을 유일하게 직접 import 한다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="72" y="476" width="282" height="148" as="geometry" />
        </mxCell>
        <mxCell id="train" value="&lt;b&gt;piper-train@&lt;job&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;[systemd 유닛 또는 SSH 원격]&lt;/i&gt;&lt;br&gt;&lt;br&gt;게이트웨이가 죽어도 산다. 로그·지표는 저널에서 되감는다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="374" y="476" width="268" height="148" as="geometry" />
        </mxCell>
        <mxCell id="psrv" value="&lt;b&gt;piper-policysrv&lt;/b&gt;&lt;br&gt;&lt;i&gt;[gRPC 유닛]&lt;/i&gt;&lt;br&gt;&lt;br&gt;정책을 GPU 에 올려 두고 지연을 줄인다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="662" y="476" width="172" height="148" as="geometry" />
        </mxCell>
        <mxCell id="yolod" value="&lt;b&gt;piper-yolod&lt;/b&gt;&lt;br&gt;&lt;i&gt;[유닛 · 필요할 때]&lt;/i&gt;&lt;br&gt;&lt;br&gt;shm 을 훑어 검출을 버스에 발행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="854" y="476" width="166" height="148" as="geometry" />
        </mxCell>
        <mxCell id="b-oll" value="호스트 — 장치를 안 여는 상시 유닛" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#8A8A8A;fontColor=#6B6B6B;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1324" y="412" width="262" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ollama" value="&lt;b&gt;piper-ollama&lt;/b&gt;&lt;br&gt;&lt;i&gt;[유닛 · 상시]&lt;/i&gt;&lt;br&gt;&lt;br&gt;로컬 판단 LLM 런타임 (qwen2.5:7b)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1344" y="452" width="222" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e-hub" value="&lt;b&gt;HuggingFace Hub&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1064" y="426" width="230" height="82" as="geometry" />
        </mxCell>
        <mxCell id="e-ssh" value="&lt;b&gt;원격 학습 서버&lt;/b&gt;&lt;br&gt;&lt;i&gt;[SSH]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1064" y="524" width="230" height="82" as="geometry" />
        </mxCell>
        <mxCell id="e-llm" value="&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTPS · 선택]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1064" y="622" width="230" height="82" as="geometry" />
        </mxCell>
        <mxCell id="b-dev" value="호스트 — 장치를 소유하는 상시 데몬 (systemd 사용자 유닛, Restart=always)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#8A8A8A;fontColor=#6B6B6B;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="682" width="1000" height="220" as="geometry" />
        </mxCell>
        <mxCell id="estopd" value="&lt;b&gt;piper-estopd&lt;/b&gt;&lt;br&gt;&lt;i&gt;[유닛 · 상시]&lt;/i&gt;&lt;br&gt;&lt;br&gt;heartbeat 시계. 끊기면 버스의 활동 PID 를 직접 SIGKILL 한다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="72" y="734" width="230" height="148" as="geometry" />
        </mxCell>
        <mxCell id="robotd" value="&lt;b&gt;piper-robotd&lt;/b&gt;&lt;br&gt;&lt;i&gt;[유닛 · 상시]&lt;/i&gt;&lt;br&gt;&lt;br&gt;CAN 소켓·팔 상태·프리셋/파킹·기구학 안전 필터" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;arcSize=12;" vertex="1" parent="1">
