              <mxPoint x="1000" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a-e4" value="JPEG 프리뷰" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=1;entryY=0.5;strokeColor=#9673a6;" edge="1" parent="1" source="a-record" target="a-preview">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="600" />
              <mxPoint x="640" y="440" />
              <mxPoint x="970" y="440" />
              <mxPoint x="970" y="297" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a-e5" value="녹화 제어" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.75;exitY=1;strokeColor=#9673a6;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="a-control" target="a-record">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="870" y="490" />
              <mxPoint x="505" y="490" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a-e6" value="타임아웃 시 kill&lt;br&gt;(전역 인스턴스 = 추론만)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="a-watchdog" target="a-pm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tobe" name="이후 — Redis 버스 + systemd">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="b-title" value="&lt;b&gt;이후&lt;/b&gt; — 데이터 평면 = Redis(제어·메타데이터), 프레임 = shm, 제어 평면 = systemd. ZMQ :5555/:5556/:5557 · Popen · stdout 파싱이 전부 사라진다" style="text;html=1;fontSize=16;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1200" height="30" as="geometry" />
        </mxCell>

        <mxCell id="b-webui" value="&lt;b&gt;Web UI&lt;/b&gt;&lt;br&gt;(React + Vite)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="50" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b-gateway" value="&lt;b&gt;piper-gateway&lt;/b&gt; (호스트)&lt;br&gt;무상태 HTTP/WS 게이트웨이 — 소유 subprocess 0개&lt;br&gt;재시작해도 Redis에서 상태를 다시 읽으면 끝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="500" y="160" width="360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b-redis" value="&lt;b&gt;Redis :6379 — 메시지 버스 (데이터 평면)&lt;/b&gt;&lt;br&gt;&lt;br&gt;명령: Streams + 응답 키 · 상태: Key + pub/sub&lt;br&gt;로그: Streams · 프레임 메타: Key + TTL&lt;br&gt;&lt;br&gt;계약은 &lt;b&gt;bus/piper_bus/&lt;/b&gt; 한 곳 — 예: piper:estop:heartbeat,&lt;br&gt;piper:activity:pids, piper:ch:estop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="320" width="360" height="160" as="geometry" />
        </mxCell>

        <mxCell id="b-hw" value="&lt;b&gt;장치 소유 데몬 — 호스트 + systemd&lt;/b&gt;&lt;br&gt;(udev·/sys·커널 모듈 때문에 컨테이너 불가)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="290" width="300" height="270" as="geometry" />
        </mxCell>
        <mxCell id="b-robotd" value="&lt;b&gt;piper-robotd&lt;/b&gt; — CAN 유일 소유&lt;br&gt;하드리밋·데드맨·기구학 필터" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="100" y="345" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b-camerad" value="&lt;b&gt;piper-camerad&lt;/b&gt; — /dev/video* (v4l2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="100" y="415" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b-rsd" value="&lt;b&gt;piper-rsd&lt;/b&gt; — RealSense USB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="100" y="480" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="b-shm" value="&lt;b&gt;/dev/shm — 카메라 프레임&lt;/b&gt;&lt;br&gt;바이너리는 버스에 안 태운다 → preview_bridge 불필요" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="80" y="610" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="b-work" value="&lt;b&gt;작업 데몬 — systemd 템플릿 유닛 (대부분 컨테이너)&lt;/b&gt;&lt;br&gt;장치는 직접 안 연다 — shm으로 읽고 robotd를 거쳐 명령" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="980" y="270" width="340" height="360" as="geometry" />
        </mxCell>
        <mxCell id="b-infer" value="piper-infer@&amp;lt;run&amp;gt; — 추론 (GPU)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="330" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-record" value="piper-record@&amp;lt;sess&amp;gt; — 녹화 (GPU)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="380" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-train" value="piper-train@&amp;lt;job&amp;gt; — 학습 (GPU)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="430" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-policysrv" value="piper-policysrv — gRPC 정책 서버" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="480" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-xferd" value="piper-encoderd · piper-xferd (Hub 전송, 호스트)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="530" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="b-estopd" value="&lt;b&gt;piper-estopd — 독립 프로세스 (분리 완료 ☑)&lt;/b&gt;&lt;br&gt;heartbeat·activity:pids를 Redis에서 읽기만 하고,&lt;br&gt;정지는 버스를 거치지 않는다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="500" y="560" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="b-systemd" value="&lt;b&gt;systemd — 제어 평면&lt;/b&gt;: 모든 데몬의 기동/정지/재시작/복원 소유 · Restart=on-failure · After=redis (기동 순서: redis → 데몬 → 게이트웨이)&lt;br&gt;컨테이너 데몬은 Quadlet/docker-run 유닛으로 기동 · journalctl -u piper-* 로 로그 일원화 · 로그아웃해도 안 죽음 (Linger 문제 해소)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="740" width="1240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b-e1" value="REST / WS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="b-webui" target="b-gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e2" value="명령 쓰기 /&lt;br&gt;상태·로그 구독" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeColor=#d79b00;" edge="1" parent="1" source="b-gateway" target="b-redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e3" value="상태 발행 /&lt;br&gt;명령 소비" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeColor=#d79b00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b-hw" target="b-redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e4" value="상태·로그 발행 /&lt;br&gt;명령 소비" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeColor=#d79b00;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b-work" target="b-redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e5" value="프레임 발행" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b-hw" target="b-shm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e6" value="프리뷰 직접 읽기" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;exitX=1;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="b-shm" target="b-gateway">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="440" y="645" />
              <mxPoint x="440" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b-e7" value="프레임 읽기 (ipc: host)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="b-shm" target="b-work">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="230" y="710" />
              <mxPoint x="1150" y="710" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b-e8" value="heartbeat·PID 폴링&lt;br&gt;(읽기 전용)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b-redis" target="b-estopd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e9" value="&lt;b&gt;SIGKILL 직접&lt;/b&gt; — 버스·게이트웨이 경유 X&lt;br&gt;(게이트웨이가 얼어도 팔은 선다)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="b-estopd" target="b-work">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1150" y="605" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
