<mxfile host="app.diagrams.net" modified="2026-08-12T00:00:00.000Z" agent="claude" version="24.0.0">
  <diagram id="asis" name="현재 — ZMQ + subprocess">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="a-title" value="&lt;b&gt;현재&lt;/b&gt; — 백엔드 단일 프로세스가 ZMQ 소켓 3개 + subprocess를 전부 소유" style="text;html=1;fontSize=16;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="720" height="30" as="geometry" />
        </mxCell>

        <mxCell id="a-webui" value="&lt;b&gt;Web UI&lt;/b&gt;&lt;br&gt;(React + Vite)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="440" y="50" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a-backend" value="&lt;b&gt;FastAPI 백엔드 — 단일 프로세스 :8000&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="180" y="180" width="780" height="230" as="geometry" />
        </mxCell>

        <mxCell id="a-routers" value="HTTP/WS 라우터" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="210" y="220" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a-watchdog" value="&lt;b&gt;estop_watchdog&lt;/b&gt;&lt;br&gt;asyncio task — 웹서버와&lt;br&gt;&lt;b&gt;같은 이벤트 루프&lt;/b&gt;&lt;br&gt;(루프 hang ⇒ E-stop도 정지)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="210" y="300" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a-pm" value="&lt;b&gt;process_manager&lt;/b&gt;&lt;br&gt;Popen · PID 보유&lt;br&gt;stdout 정규식 파싱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="430" y="220" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a-state" value="&lt;b&gt;상태 = 백엔드 메모리&lt;/b&gt;&lt;br&gt;리로드하면 유실&lt;br&gt;(subprocess는 계속 돎)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="430" y="310" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a-zmq" value="zmq_bridge&lt;br&gt;ZMQ PUSH :5555" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="720" y="215" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a-preview" value="preview_bridge&lt;br&gt;ZMQ :5556" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="720" y="275" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a-control" value="control_bridge&lt;br&gt;ZMQ :5557" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="720" y="335" width="200" height="45" as="geometry" />
        </mxCell>

        <mxCell id="a-lerobot" value="&lt;b&gt;LeRobot subprocess (wrapper/*.py · CLI)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="180" y="520" width="780" height="150" as="geometry" />
        </mxCell>
        <mxCell id="a-train" value="학습&lt;br&gt;(train)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="220" y="565" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a-record" value="녹화&lt;br&gt;(record)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="565" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a-infer" value="추론&lt;br&gt;(inference + wrapper)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="700" y="565" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a-e1" value="REST / WebSocket&lt;br&gt;(로그·상태 스트리밍)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="a-webui" target="a-backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e2" value="subprocess.Popen&lt;br&gt;spawn / kill&lt;br&gt;↑ stdout 파싱으로 상태 추출" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="a-pm" target="a-lerobot">
          <mxGeometry relative="1" as="geometry">
