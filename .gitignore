# Dependencies
frontend/node_modules/
frontend/dist/
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/

# Vendored package build artifacts (source is committed, build output is not)
vendor/**/build/
vendor/**/*.egg-info/
vendor/**/__pycache__/

# 최상위 공유 패키지 (bus/, phase/) — 소스만 커밋, 빌드 산출물은 제외.
# 게이트웨이·데몬·wrapper 가 함께 import 하므로 pip install -e 로 설치된다.
bus/**/*.egg-info/
bus/**/__pycache__/
phase/**/*.egg-info/
phase/**/__pycache__/

# Environment
backend/.env
.env

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Claude plans
.claude/plans/

# Temp
/tmp/
*.pyc
*.log
backend/outputs/
# 디버그 캡처 — 추론 debug_mode 산출물(658MB). eval_logs 는 추적 중이라 제외하지 않는다.
backend/data/debug/
rs/*.egg-info/
cam/*.egg-info/
shm/*.egg-info/
robot/*.egg-info/
act_aux/*.egg-info/
act_aux/**/__pycache__/

# 검출 가중치 (검출기가 첫 실행 때 내려받는다)
*.pt

# 검출 학습 데이터·가중치 — 런타임 산출물이라 통째로 뺀다.
#
# `*.pt` 만으로는 부족하다: 학습 유닛이 가중치 옆에 지표 JSON 을, 라벨러가
# 이미지와 `.txt` 라벨을 남긴다. 그것들은 `.pt` 가 아니라서 그대로 커밋에 섞인다.
# 디렉토리 자체는 `.gitkeep` 으로 남겨 첫 실행에 mkdir 이 필요 없게 한다.
backend/data/yolo_models/*
backend/data/yolo_datasets/*
!backend/data/yolo_models/.gitkeep
!backend/data/yolo_datasets/.gitkeep
dist/
