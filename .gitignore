# Dependencies
frontend/node_modules/
frontend/dist/
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/

# Vendored package build artifacts (source is committed, build output is not)
vendor/**/build/
vendor/**/*.egg-info/
vendor/**/__pycache__/

# 최상위 공유 패키지 (bus/, phase/) — 소스만 커밋, 빌드 산출물은 제외.
# 게이트웨이·데몬·wrapper 가 함께 import 하므로 pip install -e 로 설치된다.
bus/**/*.egg-info/
bus/**/__pycache__/
phase/**/*.egg-info/
phase/**/__pycache__/

# Environment
backend/.env
.env

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Claude plans
.claude/plans/

# Temp
/tmp/
*.pyc
*.log
backend/outputs/
# 디버그 캡처 — 추론 debug_mode 산출물(658MB). eval_logs 는 추적 중이라 제외하지 않는다.
backend/data/debug/
rs/*.egg-info/
cam/*.egg-info/
shm/*.egg-info/
robot/*.egg-info/

# YOLO 가중치 (yolod 가 첫 실행 때 내려받는다)
*.pt
